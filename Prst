<!-- ═══ SCRIPTS ═══ -->
<script>
  // ── Progress bar ──
  function updateProgress() {
    const form = document.getElementById('mainForm');
    const inputs = form.querySelectorAll('input[required], textarea[required], select[required]');
    let filled = 0;
    inputs.forEach(el => { if (el.value.trim()) filled++; });
    const pct = inputs.length ? Math.round((filled / inputs.length) * 100) : 0;
    document.getElementById('progressBar').style.width = pct + '%';
  }
  document.getElementById('mainForm').addEventListener('input', updateProgress);
  updateProgress();

  // ── Scale buttons ──
  function initScale(groupId, hiddenId) {
    const btns = document.querySelectorAll('#' + groupId + ' .scale-btn');
    const hidden = document.getElementById(hiddenId);
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        hidden.value = btn.dataset.val;
      });
    });
  }
  initScale('scaleSymptoms', 'scaleSymptoms_val');
  initScale('scaleStress', 'scaleStress_val');

  // ── Form submit via fetch (AJAX) ──
  const form = document.getElementById('mainForm');
  const submitBtn = document.getElementById('submitBtn');
  const errorMsg = document.getElementById('errorMsg');
  const successOverlay = document.getElementById('successOverlay');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorMsg.classList.remove('visible');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Slanje...';

    try {
      const data = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        form.style.display = 'none';
        successOverlay.classList.add('visible');
        window.scrollTo({ top: document.querySelector('main').offsetTop, behavior: 'smooth' });
      } else {
        throw new Error('Server error');
      }
    } catch {
      errorMsg.classList.add('visible');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Pošalji upitnik';
    }
  });
</script>
